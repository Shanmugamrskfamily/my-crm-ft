# ---------------------------------------------------------------
# Apex CRM — environment variables
# Copy to `.env.local` for local dev, or set these in the Vercel
# Project Settings → Environment Variables panel for deployments.
# ---------------------------------------------------------------

# AES-256 secret used to encrypt localStorage state and mock API payloads.
# Generate one with: `openssl rand -hex 32`
# In Vercel: mark this as an "Encrypted" secret, scoped to all environments.
NEXT_PUBLIC_AES_SECRET_KEY=replace_with_openssl_rand_hex_32

# Optional. Fully-qualified canonical URL of your deployment.
# When unset, the app falls back to VERCEL_URL (auto-injected by Vercel)
# and finally to http://localhost:3000 for local dev.
# Set this for the production environment only.
# NEXT_PUBLIC_APP_URL=https://apex-crm.your-domain.com
